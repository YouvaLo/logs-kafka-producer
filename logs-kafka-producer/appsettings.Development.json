{
   "Serilog": {
      "MinimumLevel": {
         "Default": "Information",
         "Override": {
            "Microsoft": "Warning",
            "System": "Warning",
            "logs_kafka_producer.Services.KafkaProducerService": "Debug",
            "Confluent.Kafka": "Debug"
         }
      },
      "WriteTo": [
         {
            "Name": "Console"
         }
      ]
   },

   "AllowedHosts": "*",

   // --- Parameters and security for DEVELOPMENT environment ---
   "KafkaSettings": {
      // IP Kafka Server Adresse  
      "ServerIpAddress": "localhost:9092",
      // Topic name
      "TopicName": "logs-dev-producer",
      // Without security
      "SecurityProtocol": "Plaintext"
   }
}
